# ===========================================================
# Cook With Lucia — Environment Variables
# ===========================================================
# Copy this file to .env.local and fill in your values.
# Setup order: Anthropic -> Pinterest -> ImagineAPI -> Canva -> Vercel -> Resend
# ===========================================================

# --- Already configured ---
# Database (Supabase Postgres)
# Find this in Supabase Dashboard -> Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Step 1: Anthropic (AI content generation) ---
# Get from: https://console.anthropic.com -> API Keys -> Create Key
# Model: claude-sonnet-4-5-20250929 (~$3/1M input, $15/1M output)
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Step 2: Pinterest (trends + pin posting) ---
# Get from: https://developers.pinterest.com -> My Apps -> Create App
# Needs a Pinterest Business account (convert at https://business.pinterest.com)
# Scopes needed: boards:read, boards:write, pins:read, pins:write, user_accounts:read
PINTEREST_ACCESS_TOKEN=pina_...
PINTEREST_BOARD_ID=123456789...

# --- Step 3: ImagineAPI (Midjourney image generation) ---
# Get from: https://www.imagineapi.dev -> Dashboard
# Also requires a Midjourney subscription ($10/mo)
IMAGINEAPI_URL=https://cl.imagineapi.dev
IMAGINEAPI_TOKEN=your-token-here

# --- Step 4: Canva Connect API (Pinterest pin designs) ---
# Get from: https://www.canva.dev -> Create App -> Connect API
# Requires Canva Pro ($13-15/mo)
# Template: 1000x1500px with "hero_image" and "title" placeholder elements
CANVA_API_KEY=cnapi_...
CANVA_TEMPLATE_ID=DAF...

# --- Step 5: Vercel (deploy + cron + blob storage) ---
# CRON_SECRET: auto-generated by Vercel when crons are configured
# BLOB_READ_WRITE_TOKEN: Vercel dashboard -> project -> Storage -> Create Blob Store
CRON_SECRET=your-cron-secret-here
BLOB_READ_WRITE_TOKEN=vercel_blob_...
NEXT_PUBLIC_SITE_URL=https://cookwithlucia.com

# --- Step 6: Resend (email alerts) ---
# Get from: https://resend.com -> Dashboard -> API Keys
# Free tier: 100 emails/day
RESEND_API_KEY=re_...
ALERT_EMAIL_FROM=alerts@cookwithlucia.com
ALERT_EMAIL_TO=your-email@gmail.com

# --- Optional ---
SLACK_WEBHOOK_URL=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-...
